# Copy to .env for local dev (`.env` is gitignored). Deploys inject these as
# GitHub Actions secrets -> container env vars. All values below are DUMMIES.

# ── Postgres ─────────────────────────────────────────────────────────────────
# The app connects as a least-privilege role (INSERT/SELECT only). Migrations
# run as the owner/migrator role. Postgres binds to 127.0.0.1 only.
POSTGRES_DB=assay
POSTGRES_APP_USER=assay_app
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_MIGRATOR_USER=assay_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SQLAlchemy URLs are derived from the parts above by settings.py, but can be
# overridden wholesale here if needed (e.g. in CI).
# ASSAY_DATABASE_URL=postgresql+psycopg://assay_app:change-me-app@127.0.0.1:5432/assay
# ASSAY_MIGRATOR_DATABASE_URL=postgresql+psycopg://assay_migrator:change-me-migrator@127.0.0.1:5432/assay

# ── Crawler identity (polite, legal crawling) ────────────────────────────────
# A real, descriptive User-Agent with a contact URL is required. Never crawl
# anonymously.
ASSAY_CONTACT_URL=https://example.com/assay-watch-crawler
ASSAY_USER_AGENT=assay-watch/0.0 (+https://example.com/assay-watch-crawler)

# ── Observability ────────────────────────────────────────────────────────────
# Directory the node_exporter textfile collector scrapes. The crawler writes a
# .prom file here at the end of each run.
ASSAY_METRICS_DIR=/var/lib/node_exporter/textfile_collector

# ── eBay (Phase 0: unconfigured -> adapter is skipped, never failed) ─────────
# Leave blank until developer-program access is confirmed (open question #1).
ASSAY_EBAY_CLIENT_ID=
ASSAY_EBAY_CLIENT_SECRET=
